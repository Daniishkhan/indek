# Indek — environment variables
# Copy to .env.local (apps/web and packages/db) and adjust as needed.

# Local Postgres (created via `brew services start postgresql@18 && createdb indek_dev`)
DATABASE_URL=postgres://localhost:5432/indek_dev

# better-auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
